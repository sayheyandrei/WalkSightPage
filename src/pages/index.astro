---
import BaseLayout from "../layouts/BaseLayout.astro";
import FeatureIntro from "../components/FeatureIntro.astro";
import FinalCta from "../components/FinalCta.astro";
import HomeHero from "../components/HomeHero.astro";
import NearbySection from "../components/NearbySection.astro";
import RouteShowcase from "../components/RouteShowcase.astro";
import SiteFooter from "../components/SiteFooter.astro";
import DownloadButton from "../components/DownloadButton.astro";
---

<BaseLayout title="WalkSight — Explore More Around You" path="/" bodyClass="page-home">
  <DownloadButton variant="float" />
  <main id="main">
    <HomeHero />
    <FeatureIntro />
    <RouteShowcase />
    <NearbySection />
    <FinalCta />
  </main>
  <SiteFooter />
</BaseLayout>
