---
import { NAV_LINKS, withBase } from "../config/site";
import Logo from "./Logo.astro";
import QrCode from "./QrCode.astro";
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <nav class="footer-nav" aria-label="Footer">
      <ul>
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={withBase(link.href)}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <QrCode class="site-footer__qr" />
    <Logo tone="footer" class="site-footer__logo" />
  </div>
</footer>
