---
import { NAV_LINKS, withBase } from "../config/site";
import DownloadButton from "./DownloadButton.astro";
import Logo from "./Logo.astro";
import ThemeControls from "./ThemeControls.astro";

interface Props {
  variant?: "home" | "inner";
  /** Current route, used to mark the active navigation item. */
  path?: string;
  id?: string;
}

const { variant = "home", path = "/", id } = Astro.props;
---

<header class:list={["site-header", variant === "inner" && "site-header--inner"]} id={id}>
  {
    variant === "home" ? (
      <Logo />
    ) : (
      <a class="back-btn" href={withBase("/")} aria-label="Back to Walk&amp;Sight">
        <span class="back-btn__icon" aria-hidden="true" />
      </a>
    )
  }
  <div class="site-header__menu">
    {variant === "home" && <DownloadButton variant="compact" class="site-header__cta" />}
    <nav class="site-nav" aria-label="Primary">
      <ul>
        {
          NAV_LINKS.map((link) => (
            <li>
              {path === link.href ? (
                <span class="site-nav__current" aria-current="page">
                  {link.label}
                </span>
              ) : (
                <a href={withBase(link.href)}>{link.label}</a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeControls />
  </div>
</header>
