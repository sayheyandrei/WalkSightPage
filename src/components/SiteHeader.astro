---
import { NAV_LINKS } from "../config/site";
import Logo from "./Logo.astro";
import ThemeControls from "./ThemeControls.astro";

interface Props {
  variant?: "home" | "inner";
  /** Current route, used to mark the active navigation item. */
  path?: string;
  id?: string;
}

const { variant = "home", path = "/", id } = Astro.props;
---

<header class:list={["site-header", variant === "inner" && "site-header--inner"]} id={id}>
  {
    variant === "home" ? (
      <Logo />
    ) : (
      <a class="back-btn" href="/" aria-label="Back to WalkSight">
        <span class="back-btn__icon" aria-hidden="true" />
      </a>
    )
  }
  <div class="site-header__menu">
    <nav class="site-nav" aria-label="Primary">
      <ul>
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} aria-current={path === link.href ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeControls />
  </div>
</header>
