---
import { screens } from "../content/images";
import DownloadButton from "./DownloadButton.astro";
import Phone from "./Phone.astro";
---

<section class="explore" aria-labelledby="explore-title">
  <div class="container explore__inner">
    <div class="intro explore__text reveal">
      <h1 class="display" id="explore-title">Explore more<br />around you</h1>
      <p class="lead" data-words>
        Discover landmarks, viewpoints, parks, cafés and hidden gems.<br class="only-desktop" />
        Build a walking route around your time, distance and interests.
      </p>
      <DownloadButton />
    </div>
    <div class="explore__row" data-explore-row>
      <div class="explore__phone explore__phone--place" data-explore-phone="1">
        <Phone screen={screens.place} label="Walk&Sight place details for St John's Co-Cathedral" />
      </div>
      <div class="explore__phone explore__phone--planner" data-explore-phone="2">
        <Phone screen={screens.planner} label="Walk&Sight route planner with Auto and Manual modes, radius, length and time options" />
      </div>
      <div class="explore__phone explore__phone--route" data-explore-phone="3">
        <Phone screen={screens.route} label="Walk&Sight turn-by-turn walking navigation" />
      </div>
    </div>
  </div>
</section>
