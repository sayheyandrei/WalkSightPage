---
import DownloadButton from "./DownloadButton.astro";
import Phone from "./Phone.astro";
---

<div class="curve" aria-hidden="true">
  <img class="u-light" src="/assets/svg/curve-light.svg" width="1440" height="201" alt="" loading="lazy" decoding="async" />
  <img class="u-dark" src="/assets/svg/curve-dark.svg" width="1920" height="268" alt="" loading="lazy" decoding="async" />
</div>

<section class="final" aria-labelledby="final-title">
  <div class="final__bg" aria-hidden="true">
    <img class="u-light" src="/assets/svg/final-bg-light.svg" width="1440" height="1500" alt="" loading="lazy" decoding="async" />
    <img class="u-dark" src="/assets/svg/final-bg-dark.svg" width="1920" height="2000" alt="" loading="lazy" decoding="async" />
  </div>
  <div class="container final__inner">
    <div class="intro intro--center">
      <h2 class="display" id="final-title">Explore more<br />around you</h2>
      <p class="lead lead--b">
        Discover landmarks, viewpoints, parks, cafés and hidden gems.<br class="only-desktop" />
        Build a walking route around your time, distance and interests.
      </p>
      <DownloadButton variant="inverse" />
    </div>
  </div>
  <img class="final__arrow u-light" src="/assets/svg/final-arrow-light.svg" width="96" height="96" alt="" aria-hidden="true" loading="lazy" decoding="async" />
  <img class="final__arrow u-dark" src="/assets/svg/final-arrow-dark.svg" width="126" height="126" alt="" aria-hidden="true" loading="lazy" decoding="async" />
  <div class="final__phone" aria-hidden="true">
    <Phone variant="ring" />
  </div>
</section>
