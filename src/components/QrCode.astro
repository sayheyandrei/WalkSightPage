---
import QRCode from "qrcode";
import { APP_STORE_URL } from "../config/site";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

/**
 * The QR code is generated from APP_STORE_URL (the Figma artwork encodes a
 * different app). Until the listing exists it encodes a plain-text note, so it
 * never points anywhere wrong.
 */
const payload = APP_STORE_URL || "Walk&Sight. The App Store link will appear here.";
const qr = QRCode.create(payload, { errorCorrectionLevel: "M" });
const size = qr.modules.size;
const data = qr.modules.data;

const margin = 3;
const total = size + margin * 2;
let path = "";
for (let y = 0; y < size; y++) {
  let x = 0;
  while (x < size) {
    if (data[y * size + x]) {
      let run = 1;
      while (x + run < size && data[y * size + x + run]) run++;
      path += `M${x + margin} ${y + margin}h${run}v1h-${run}z`;
      x += run;
    } else {
      x++;
    }
  }
}
const label = APP_STORE_URL
  ? "QR code: download Walk&Sight on the App Store"
  : "QR code placeholder for the Walk&Sight App Store link";
---

{
  APP_STORE_URL ? (
    <a class:list={["qr", className]} href={APP_STORE_URL} rel="noopener" aria-label={label}>
      <svg viewBox={`0 0 ${total} ${total}`} shape-rendering="crispEdges" aria-hidden="true">
        <path d={path} fill="currentColor" />
      </svg>
    </a>
  ) : (
    <div class:list={["qr", className]} role="img" aria-label={label}>
      <svg viewBox={`0 0 ${total} ${total}`} shape-rendering="crispEdges" aria-hidden="true">
        <path d={path} fill="currentColor" />
      </svg>
    </div>
  )
}
