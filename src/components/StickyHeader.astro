---
import { NAV_LINKS, withBase } from "../config/site";
import DownloadButton from "./DownloadButton.astro";
import Logo from "./Logo.astro";
import ThemeControls from "./ThemeControls.astro";
---

<!-- Dedicated sticky states from Figma: 942:31340 (1920), 942:31642 (1440), 942:31959 (375). -->
<div class="sticky-header site-header" data-sticky-header>
  <Logo />
  <div class="site-header__menu">
    <DownloadButton variant="compact" />
    <nav class="site-nav" aria-label="Primary (sticky)">
      <ul>
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={withBase(link.href)}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeControls />
  </div>
</div>
<DownloadButton variant="float" />
