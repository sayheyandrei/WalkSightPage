---
import { SUPPORT_EMAIL } from "../config/site";
import type { LegalSection } from "../content/legal";

interface Props {
  sections: LegalSection[];
}

const { sections } = Astro.props;

/** Splits a paragraph around the {{email}} token so the address becomes a real mailto link. */
function parts(paragraph: string): Array<{ text: string } | { email: true }> {
  return paragraph
    .split("{{email}}")
    .flatMap((text, index, all) => {
      const chunk = text ? [{ text }] : [];
      return index < all.length - 1 ? [...chunk, { email: true as const }] : chunk;
    });
}
---

<div class="legal">
  {
    sections.map((section) => (
      <section class="legal__section reveal">
        <h2 class="legal__title">{section.title}</h2>
        {section.paragraphs.map((paragraph) => (
          <p class="legal__text">
            {parts(paragraph).map((part) =>
              "email" in part ? <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a> : part.text,
            )}
          </p>
        ))}
      </section>
    ))
  }
</div>
