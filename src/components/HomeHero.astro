---
import { screens } from "../content/images";
import Phone from "./Phone.astro";
import SiteHeader from "./SiteHeader.astro";
---

<div class="hero">
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__bg-inner"></div>
  </div>
  <div class="container hero__inner">
    <div class="hero__header-slot" data-header-slot>
      <SiteHeader variant="home" path="/" id="site-header" />
    </div>
    <div class="hero__phone" data-hero-phone>
      <div class="hero__phone-tilt" data-hero-tilt>
        <Phone screen={screens.hero} eager label="WalkSight map showing nearby landmarks, cafés and parks around the user" />
      </div>
    </div>
  </div>
</div>
